diff --git a/go/core/pkg/sandboxbackend/substrate/actor_reachability_test.go b/go/core/pkg/sandboxbackend/substrate/actor_reachability_test.go
index 55af8de..5990f4d 100644
--- a/go/core/pkg/sandboxbackend/substrate/actor_reachability_test.go
+++ b/go/core/pkg/sandboxbackend/substrate/actor_reachability_test.go
@@ -139,3 +139,19 @@ func TestWaitForActorReachableViaAtenetTimesOut(t *testing.T) {
 		t.Fatal("expected timeout error")
 	}
 }
+
+type suspendingThenSuspended struct { calls atomic.Int32; resumes atomic.Int32 }
+func (s *suspendingThenSuspended) GetActor(context.Context, string, string) (*ateapipb.Actor, error) {
+ if s.calls.Add(1) == 1 { return &ateapipb.Actor{Status: ateapipb.Actor_STATUS_SUSPENDING}, nil }
+ return &ateapipb.Actor{Status: ateapipb.Actor_STATUS_SUSPENDED}, nil
+}
+func (s *suspendingThenSuspended) ResumeActor(context.Context, string, string) (*ateapipb.Actor, error) {
+ s.resumes.Add(1); return &ateapipb.Actor{Status: ateapipb.Actor_STATUS_RUNNING}, nil
+}
+func TestReachableResumesAfterConcurrentSuspend(t *testing.T) {
+ srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) { w.WriteHeader(http.StatusOK) })); defer srv.Close()
+ actors := &suspendingThenSuspended{}
+ ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second); defer cancel()
+ if err := waitForActorReachableViaAtenet(ctx, actors, srv.Client(), srv.URL, "kagent", "asr-test"); err != nil { t.Fatal(err) }
+ if actors.resumes.Load() != 1 { t.Fatalf("resumes = %d, want 1", actors.resumes.Load()) }
+}
