# 配置模板：复制成 .env 后改成你自己的环境
#   cp config.env.example .env && $EDITOR .env
# 所有脚本都会读取 .env；缺必填项会直接报错退出。

# ─────────────────────────────────────────────
# 1) DCE 环境（必需：本仓库是 DCE 的附庸，没有 DCE 只能跑 mock）
# ─────────────────────────────────────────────
# DCE 控制台地址（浏览器登录的那个），末尾不要带 /
DCE_ORIGIN=http://10.31.223.20:31284
# DCE 的数据库/集群名，用于 kpanda API 路径
DCE_CLUSTER=kpanda-global-cluster
# DCE 签发 JWT 的 issuer / audience（从 DCE 控制台的 token 里能看到）
JWT_ISSUER=https://10.31.223.20:31909/auth/realms/ghippo
JWT_AUDIENCE=__internal-ghippo
# JWKS：如果 DCE 的 JWKS 需要特殊 CA，把文件放 deploy/jwks/jwks.json 并填这个路径（容器内路径）
JWKS_FILE=/etc/adapter/jwks.json

# ─────────────────────────────────────────────
# 2) 镜像仓库（必需）
# ─────────────────────────────────────────────
# 集群能拉到的仓库前缀，不要带协议和末尾 /
# 必须是你自己集群能拉的仓库（本项目不提供现成镜像，一律自己构建）
IMAGE_REGISTRY=registry.example.com/dce-copilot
IMAGE_PREFIX=
IMAGE_TAG=0.1.0
# 目标架构：服务器一般是 linux/amd64；Apple Silicon 本机跑用 linux/arm64
TARGET_PLATFORM=linux/amd64
# 推镜像用（可选；不填则 build 后只打 tag 不 push）
# docker login 需提前做过
PUSH_IMAGES=true

# DSH 基础镜像：DSH 官方/内部构建的运行时，仓库里不含它。
# 没有的话，images/dsh-a2a/Dockerfile 会失败——见 docs/replicate.md「DSH 基础镜像」
DSH_BASE_IMAGE=registry.example.com/deepseek-harness/dsh-runtime:v3

# ─────────────────────────────────────────────
# 3) 集群与命名空间
# ─────────────────────────────────────────────
NS_KAGENT=kagent
NS_APP=watsons-agent-poc
NS_SUBSTRATE=ate-system
NS_GATEWAY=kgateway-system
STORAGE_CLASS=local-path

# ─────────────────────────────────────────────
# 4) 版本（固定，不要 follow latest）
# ─────────────────────────────────────────────
KGATEWAY_VERSION=v2.5.0
SUBSTRATE_VERSION=0.0.8
KAGENT_VERSION=0.10.0-beta6
# DaoCloud/daocloud-skills 的 tag：提供 dce CLI 与 skills
DCE_SKILLS_VERSION=v0.2.0-rc.16

# ─────────────────────────────────────────────
# 5) 入口网关
# ─────────────────────────────────────────────
# loadbalancer | nodeport | ingress
GATEWAY_MODE=loadbalancer
# 有域名填域名（扩展和 curl 都用它），没有就留空
GATEWAY_HOST=
# 没有域名时填 IP；LoadBalancer 模式下脚本会自动探测
GATEWAY_IP=

# ─────────────────────────────────────────────
# 6) 浏览器扩展
# ─────────────────────────────────────────────
# 扩展只允许在这个源上运行，必须与 DCE_ORIGIN 一致
EXTENSION_MATCH_ORIGIN=http://10.31.223.20:31284
# 扩展访问的网关地址（从浏览器所在机器可达）：
#   有域名 → http://agent.example.com
#   否则   → http://<GATEWAY_IP>:<端口>
EXTENSION_GATEWAY_BASE=http://10.31.223.20:31284

# ─────────────────────────────────────────────
# 7) 模型
# ─────────────────────────────────────────────
# 只写变量名，真值放 secrets/.env.secret（不进 git）
DSH_MODEL_PROVIDER=deepseek-official
DSH_MODEL=deepseek-v4-flash
# off | low | high | max | 留空=用云端默认
DSH_REASONING_EFFORT=

# ─────────────────────────────────────────────
# 8) 开关（默认安全优先）
# ─────────────────────────────────────────────
# NetworkPolicy：默认不装。即使装了，kagent worker 与 actor 共享网络命名空间，
# 不能按用户区分——详见 docs/security.md
WITH_NETWORKPOLICY=false
# gVisor：OrbStack 上需要 -ignore-cgroups；真实 x86 服务器一般不需要。
# auto = 运行时探测 worker 的 cgroup 是否可写
GVISOR_IGNORE_CGROUPS=auto
