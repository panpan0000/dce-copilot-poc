# 配置模板：复制成 .env 后改成你自己的环境
#   cp config.env.example .env && $EDITOR .env
# 所有脚本都会读取 .env；缺必填项会直接报错退出。
# 本文件不含任何密钥/密码，真实凭据放 secrets/.env.secret（已 gitignore）。

# ─────────────────────────────────────────────
# 1) DCE 环境（必需：本仓库是 DCE 的附庸，没有 DCE 只能跑 mock）
# ─────────────────────────────────────────────
# DCE 控制台地址（浏览器登录的那个），末尾不要带 /
DCE_ORIGIN=https://demo-tf-alpha.daocloud.cn
# DCE 里托管的 K8s 集群名（kubectl 用例会打到这个集群）
DCE_CLUSTER=jinye-gpu-cluster
# DCE 签发 JWT 的 issuer / audience（从 DCE 控制台的 token 里能看到）
JWT_ISSUER=https://demo-tf-alpha.daocloud.cn/auth/realms/ghippo
JWT_AUDIENCE=__internal-ghippo
# JWKS：DCE 的公钥（部署前从 DCE 拉一次，运行时挂载进 adapter）
JWKS_FILE=/etc/adapter/jwks.json

# ─────────────────────────────────────────────
# 2) 镜像仓库（必需）
# ─────────────────────────────────────────────
# 集群能拉到的仓库，不要带协议和末尾 /。示例：release-ci.daocloud.io/common-ci
IMAGE_REGISTRY=release-ci.daocloud.io/common-ci
IMAGE_PREFIX=dce-copilot-
IMAGE_TAG=0.2.0-x86
# 目标架构：服务器用 linux/amd64（本项目默认按 x86 服务器设计）
TARGET_PLATFORM=linux/amd64
# 推镜像用（可选；不填则 build 后只打 tag 不 push，docker login 需提前做过）
PUSH_IMAGES=true

# DSH 基础镜像：DSH 运行时（含 dsh + kubectl + python + git）。
# 已构建好 amd64 版本并推到仓库里；要自己重建见 docs/install.md「DSH 运行时」。
DSH_BASE_IMAGE=release-ci.daocloud.io/common-ci/dsh-runtime:0.1.1

# ─────────────────────────────────────────────
# 3) 集群与命名空间
# ─────────────────────────────────────────────
NS_KAGENT=kagent
NS_APP=watsons-agent-poc
NS_SUBSTRATE=ate-system
NS_GATEWAY=kgateway-system
STORAGE_CLASS=local-path

# ─────────────────────────────────────────────
# 4) 版本（固定，不要 follow latest）
# ─────────────────────────────────────────────
KGATEWAY_VERSION=v2.5.0
SUBSTRATE_VERSION=0.0.8
KAGENT_VERSION=0.10.0-beta6
# DaoCloud/daocloud-skills 的 tag：提供 dce CLI 与 skills
DCE_SKILLS_VERSION=v0.2.0-rc.16

# ─────────────────────────────────────────────
# 5) 入口网关
# ─────────────────────────────────────────────
# loadbalancer | nodeport | ingress
# 集群没有 LoadBalancer 实现时用 nodeport（jinye 就是这样）
GATEWAY_MODE=nodeport
# 有域名填域名（扩展和 curl 都用它），没有就留空
GATEWAY_HOST=
# 没有域名时填节点 IP；NodePort 模式下脚本会自动探测节点 IP
GATEWAY_IP=

# ─────────────────────────────────────────────
# 6) 浏览器扩展
# ─────────────────────────────────────────────
# 扩展只允许在这个源上运行，必须与 DCE_ORIGIN 一致
EXTENSION_MATCH_ORIGIN=https://demo-tf-alpha.daocloud.cn
# 扩展访问的网关地址（从浏览器所在机器可达）：
#   有域名 → http://agent.example.com
#   NodePort → http://<节点IP>:<nodePort>（make install-agent 结束会打印）
EXTENSION_GATEWAY_BASE=

# ─────────────────────────────────────────────
# 7) 模型
# ─────────────────────────────────────────────
# 只写变量名，真值放 secrets/.env.secret（不进 git）
DSH_MODEL_PROVIDER=deepseek-official
DSH_MODEL=deepseek-v4-flash
# off | low | high | max | 留空=用云端默认
DSH_REASONING_EFFORT=

# ─────────────────────────────────────────────
# 8) 开关（默认安全优先）
# ─────────────────────────────────────────────
# NetworkPolicy：默认不装。即使装了，kagent worker 与 actor 共享网络命名空间，
# 不能按用户区分——详见 docs/security.md
WITH_NETWORKPOLICY=false
# gVisor：真实 x86 服务器一般不需要额外参数；自动探测即可
GVISOR_IGNORE_CGROUPS=auto
