# 密钥模板：复制成 secrets/.env.secret（已在 .gitignore 里）
#   mkdir -p secrets && cp secrets.env.example secrets/.env.secret && $EDITOR secrets/.env.secret
# 这个文件里的值只会进入 K8s Secret，不会进镜像、不会进 git。

# 模型 API Key（DSH 直连云端 DeepSeek 时使用）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# SRE Agent 访问集群用的只读 token（如果 SRE 用 ServiceAccount，可留空由 SA 提供）
SRE_SERVICE_TOKEN=

# 可选的额外模型 key（例如 DCE 分配的个人内网 key）
DCE_MODEL_API_KEY=
