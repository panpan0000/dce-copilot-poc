{
  "manifest_version": 3,
  "name": "DCE Agent POC Bridge",
  "version": "0.6.0",
  "description": "在 DCE 页面内把当前用户会话转发到 Kubernetes POC Agent。",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://demo-tf-alpha.daocloud.cn/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "DCE Agent POC"
  },
  "options_page": "options.html"
}
